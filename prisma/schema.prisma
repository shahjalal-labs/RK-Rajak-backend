datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String?
  phone             String     @unique
  address           String?
  email             String?
  isProfileComplete Boolean    @default(false)
  isVerifyed        Boolean    @default(false)
  buyerRating       Float?     @default(0)
  fcmToken          String?
  profileImage      String?    @default("https://i.ibb.co.com/nrs3FjM/images.png")
  shopOpeningTime   String?
  role              UserRole
  status            UserStatus @default(Active)
  referralCode      String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  branch            branch?    @relation(fields: [branchId], references: [id])
  branchId          String?    @db.ObjectId
  agentId           String?    @db.ObjectId
  threshold         Int?       @default(0)
  discount          Float?     @default(0)

  // Dues tracking
  activeDuesCount Int   @default(0) // Current number of unpaid credit orders
  totalDuesAmount Float @default(0) // Total amount in dues

  shippingAddress     shippingAddress[]
  verificationUsers   verificationUsers?
  UserLocation        UserLocation?
  Wallet              Wallet?
  Spin                Spin[]
  Review              Review[]
  dailyOrders         DailyOrder[]
  reffaralUsages      reffaralUsages[]
  driverAssignments   DriverAssignment[]
  rewards             Reward[]
  incentiveProgresses IncentiveProgress[]

  @@map("users")
}

model reffaralUsages {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  usedBy       String   @db.ObjectId
  userId       String   @db.ObjectId
  reffaralUser User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}

model PendingUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  role      UserRole @default(Customer)
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pendingUsers")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  All
  New
  Active
  Inactive
  Reactivate
  Online
  Offline
  PerDayOrder
  Blocked
  Deleted
}

enum UserRole {
  SuperAdmin
  Admin
  Customer
  Agent
  Owner
  Driver
}

model UserLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@map("user_locations")
}

model shippingAddress {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  user        User?        @relation(fields: [userId], references: [id])
  userId      String?      @db.ObjectId
  shopName    String
  landmark    String
  address     String
  latitude    Float
  longitude   Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dailyOrders DailyOrder[]

  @@map("shippingAddresses")
}

model verificationUsers {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?  @unique @db.ObjectId
  buyerName  String
  buyerPhoto String
  shopName   String
  shopPhoto  String
  documents  String[]
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("verificationUsers")
}

// ------- branchs  information
model branch {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  location          String
  isOpen            Boolean             @default(true)
  latitude          Float
  longitude         Float
  openingTime       String
  closingTime       String
  verticalBanner    verticalBanner[]
  horizontalBanner  horizontalBanner[]
  handalingCharge   handalingCharge[]
  cartValue         cartValue[]
  User              User[]
  product           product[]
  productCategory   productCategory[]
  livePhotoCategory livePhotoCategory[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  totalProductOrders totalProductOrder[]
  incentives         Incentive[]

  @@map("branchs")
}

model livePhoto {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  livePhotoCategory   livePhotoCategory? @relation(fields: [livePhotoCategoryId], references: [id], onDelete: Cascade)
  livePhotoCategoryId String?            @db.ObjectId
  photo               String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model livePhotoCategory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String      @unique
  image     String
  branchId  String      @db.ObjectId
  branch    branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  livePhoto livePhoto[]
}

model handalingCharge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  charge    Float
  condition String
  branch    branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("handalingCharges")
}

model cartValue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  minValue  Float
  branch    branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cartValues")
}

// ---------------------------------  Banner Models -------------------------///
model verticalBanner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String? @db.ObjectId

  @@map("verticalBanners")
}

model horizontalBanner {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  branch                 branch?                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId               String?                  @db.ObjectId
  horizontalBannerSlider horizontalBannerSlider[]

  @@unique([branchId])
  @@map("horizontalBanners")
}

model horizontalBannerSlider {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  serialNo  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horizontalBanner   horizontalBanner? @relation(fields: [horizontalBannerId], references: [id], onDelete: Cascade)
  horizontalBannerId String?           @db.ObjectId

  @@unique([horizontalBannerId])
  @@map("horizontalBannerSliders")
}

//-//-------------------------------------- Product and Order Models --------------------//

model product {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  images     String[]
  tag        String
  status     Boolean         @default(true)
  branchId   String          @db.ObjectId
  branch     branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId String          @db.ObjectId
  category   productCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  productVariation   productVariation[]
  orderProducts      OrderProduct[]
  totalProductOrders totalProductOrder[]

  @@map("products")
}

model productVariation {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  realPrice         Float
  sellingPrice      Float
  availableQuantity Int
  minOrderQuantity  Int
  maxOrderQuantity  Int
  unit              unit
  weight            Float

  product   product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?  @db.ObjectId
}

enum unit {
  KG
  Box
  Punnet
  Tray
}

model productCategory {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String               @unique
  image              String?
  branchId           String               @db.ObjectId
  branch             branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  productSubcategory productSubcategory[]
  product            product[]
  totalProductOrders totalProductOrder[]

  @@map("productCategories")
}

model productSubcategory {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  productCategoryId String?          @db.ObjectId
  productCategory   productCategory? @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("productSubcategories")
}

//###############-########----- Order System -------------#######################

// daily Order  collection for user 
model DailyOrder {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  user                User?            @relation(fields: [userId], references: [id])
  userId              String?          @db.ObjectId
  OrderProducts       OrderProduct[] // all products in the order
  totalAmount         Float            @default(0) // calculated total amount from OrderProducts
  totalWeight         Float?           @default(0) // calculated total weight from OrderProducts
  totalAcceptedWeight Float?           @default(0) // calculated total accepted weight from OrderProducts
  totalRejectedWeight Float?           @default(0) // calculated total rejected weight from OrderProducts
  totalReturnedWeight Float?           @default(0) // calculated total returned weight from OrderProducts
  totalAcceptedPrice  Float?           @default(0) // calculated total accepted price from OrderProducts
  totalRejectedPrice  Float?           @default(0) // calculated total rejected price from OrderProducts
  totalReturnedPrice  Float?           @default(0) // calculated total returned price from OrderProducts
  status              OrderStatus      @default(Pending)
  cancellationReason  String?
  DeliveryProof       String?
  shippingAddressId   String?          @db.ObjectId
  shippingAddress     shippingAddress? @relation(fields: [shippingAddressId], references: [id])
  orderDate           String? // date string for daily orders aggregation
  branchId            String?          @db.ObjectId

  // Payment tracking
  paymentMethod PaymentMethod? // if credit and also RemainingAmount is greater than 0. then its called dues payment

  // Wallet payment tracking
  walletAmountUsed Float? @default(0)
  RemainingAmount  Float  @default(0)

  // Dues/Credit tracking
  isDues        Boolean?  @default(false)
  duesCleared   Boolean?  @default(false)
  duesClearedAt DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  driverAssignments DriverAssignment[]

  @@map("orders")
}

// order products  collection for user 

model OrderProduct {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  orderId               String?                 @db.ObjectId
  order                 DailyOrder?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               product?                @relation(fields: [productId], references: [id])
  productId             String?                 @db.ObjectId
  totalWeight           Float?                  @default(0) // Total weight for this product and its can editable in future by admin and delivery driver
  totalQuantity         Float?                  @default(0) // Total quantity for this product and its can editable in future by admin and delivery driver
  acceptedQuantity      Float?                  @default(0)
  returnedQuantity      Float?                  @default(0)
  totalPrice            Float?                  @default(0) // Total price for this product and its can editable in future by admin and delivery driver
  totalWalletAmountUsed Float?                  @default(0) // total wallet amount used for this product
  returnedPrice         Float?                  @default(0)
  rejectedPrice         Float?                  @default(0)
  acceptedPrice         Float?                  @default(0)
  acceptedWeight        Float?                  @default(0)
  rejectedWeight        Float?                  @default(0)
  returnedWeight        Float?                  @default(0)
  // if fully cancelled or returned then need to status as cancelled or returned
  status                OrderProductStatus      @default(Active) // Product lifecycle status
  OrderProductVariation OrderProductVariation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, productId])
}

model OrderProductVariation {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  orderProduct   OrderProduct @relation(fields: [orderProductId], references: [id], onDelete: Cascade)
  orderProductId String       @db.ObjectId
  variationId    String       @db.ObjectId
  quantity       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// total order product collection for admin adn superadmin for one day

model totalProductOrder {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  productId         String             @db.ObjectId
  product           product?           @relation(fields: [productId], references: [id])
  productCategory   productCategory    @relation(fields: [productCategoryId], references: [id])
  productCategoryId String             @db.ObjectId
  branchId          String             @db.ObjectId
  branch            branch             @relation(fields: [branchId], references: [id])
  totalOrders       Int?
  totalQuantity     Int?               @default(0)
  totalWeight       Float?
  totalPrice        Float?             @default(0)
  // Separate fields for accepted, rejected, and returned weights 
  acceptedWeight    Float?             @default(0)
  rejectedWeight    Float?             @default(0)
  returnedWeight    Float?             @default(0)
  // Separate fields for accepted, rejected, and returned prices
  acceptedPrice     Float?             @default(0)
  rejectedPrice     Float?             @default(0)
  returnedPrice     Float?             @default(0)
  // Store main order IDs associated with this product on that date
  orderIds          String[]           @db.ObjectId
  orderDateString   String
  status            OrderProductStatus @default(Active)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productId, orderDateString])
  @@map("totalProductOrders")
}

enum OrderProductStatus {
  Active // defult and also when return partial or cancelled partial
  Confirmed // when admin or superadmin accept the order product
  Returned // if delivery driver cancel fully then its called returned
  PartialReturned // if delivery driver cancel partial then its called partial returned
  Cancelled // if admin or superAdmin cancelled it called cancelled
  PartialCancelled // if admin or superAdmin cancelled partial then its called partial cancelled
}

enum OrderStatus {
  Pending
  Active
  OnTheWay
  Delivered
  Cancelled
  Returned
  PartialReturned
}

enum PaymentMethod {
  COD // cash on delivery
  Cash // cash payment
  Wallet // wallet amount used
  Pre_Paid // pre-paid online payment
  Credit // delivery boy assign as credit and user clear dues later
  QrCode // delivery boy show scanner and collects payment
  Online // after clearing dues
}

/// ----------------------------- /// Assign main orders to delivery Driver // under one driver assign multiple main orders -----------------///

model DriverAssignment {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  driverId     String      @db.ObjectId
  driver       User?       @relation(fields: [driverId], references: [id])
  dailyOrderId String      @db.ObjectId
  dailyOrder   DailyOrder? @relation(fields: [dailyOrderId], references: [id])
  assignedAt   DateTime    @default(now())
  deliveryDate DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("driverAssignments")
}

/// ------ Buyer  Review Model -----///

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

/// ---------- Wallet and spins Models -----//

model Wallet {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  user               User?               @relation(fields: [userId], references: [id])
  userId             String?             @unique @db.ObjectId
  balance            Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
  WalletRecharge     WalletRecharge[]

  @@index([userId, id])
  @@map("wallets")
}

model WalletTransaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  wallet      Wallet?         @relation(fields: [walletId], references: [id])
  walletId    String?         @db.ObjectId
  amount      Float
  type        TransactionType
  description String? // e.g., "Order payment", "Refund for order #123"
  orderId     String? // Track which order this transaction is for
  status      String?         @default("Success") // "Success", "Pending", "Failed"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("walletTransactions")
}

enum TransactionType {
  Credit
  Debit
}

enum PaymentStatus {
  Pending
  Completed
  Failed
  Refunded
}

model WalletRecharge {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  wallet           Wallet?       @relation(fields: [walletId], references: [id])
  walletId         String?       @db.ObjectId
  amount           Float
  paymentGateway   String        @default("cashfree")
  cashfreeOrderId  String?       @unique
  paymentSessionId String?
  paymentStatus    PaymentStatus @default(Pending)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("walletRecharges")
}

// -------------------------------- Spin Models -------------------------///

model Spin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  wonAmount Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spins")
}

model spinValue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId  String   @db.ObjectId
  spinValue Float
  month     DateTime
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, month, year], name: "branch_month_year_index")
  @@map("spinValues")
}

/// --- ------------------------------- Contact and Notification Models --------//
model contact {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------  Notification Models -------------------------///
model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String?  @db.ObjectId
  senderId   String?  @db.ObjectId
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

// ---------------------------------  Incentives and rewards Schema -------------------------///

model Incentive {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  role                UserRole
  // support multiple incentive types 2monthly , 3weekly , referral , zero returns
  type                IncentiveType
  targetAmount        Float?
  rewardAmount        Float
  branchId            String?             @db.ObjectId
  branch              branch?             @relation(fields: [branchId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  rewards             Reward[]
  incentiveProgresses IncentiveProgress[]

  @@map("incentives")
}

enum IncentiveType {
  Refar
  Zero_returns
  Weekly_achievement
  Monthly_achievement
}

///------------- tracking user rewards ---------------///

// DO I need to track like user need to see progress toward reward achievement?

// Then reward model to track achieved rewards
model Reward {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  user        User?      @relation(fields: [userId], references: [id])
  incentiveId String     @db.ObjectId
  incentive   Incentive? @relation(fields: [incentiveId], references: [id])
  amount      Float
  achievedAt  DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("rewards")
}

model IncentiveProgress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  incentiveId   String   @db.ObjectId
  currentAmount Float    @default(0)
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  incentive Incentive? @relation(fields: [incentiveId], references: [id])

  @@map("incentive_progress")
}
