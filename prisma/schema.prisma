datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String?
  phone             String     @unique
  address           String?
  email             String?
  isProfileComplete Boolean    @default(false)
  isVerifyed        Boolean    @default(false)
  buyerRating       Float?     @default(0)
  fcmToken          String?
  profileImage      String?    @default("https://i.ibb.co.com/nrs3FjM/images.png")
  shopOpeningTime   String?
  role              UserRole
  status            UserStatus @default(Active)
  referralCode      String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  branch            branch?    @relation(fields: [branchId], references: [id])
  branchId          String?    @db.ObjectId
  agentId           String?    @db.ObjectId
  threshold         Int?       @default(0)
  discount          Float?     @default(0)

  // Dues tracking
  activeDuesCount Int   @default(0) // Current number of unpaid credit orders
  totalDuesAmount Float @default(0) // Total amount in dues

  order             order[]
  shippingAddress   shippingAddress[]
  verificationUsers verificationUsers?
  UserLocation      UserLocation?
  Wallet            Wallet?
  Spin              Spin[]
  Review            Review[]
  DuesPayment       DuesPayment[]

  @@map("users")
}

model PendingUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  role      UserRole @default(Customer)
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pendingUsers")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  All
  New
  Active
  Inactive
  Reactivate
  Online
  Offline
  PerDayOrder
  Blocked
  Deleted
}

enum UserRole {
  SuperAdmin
  Admin
  Customer
  Agent
  Owner
  Driver
}

model UserLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@map("user_locations")
}

model shippingAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  shopName  String
  landmark  String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     order[]

  @@map("shippingAddresses")
}

model verificationUsers {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?  @unique @db.ObjectId
  buyerName  String
  buyerPhoto String
  shopName   String
  shopPhoto  String
  documents  String[]
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("verificationUsers")
}

// ------- branchs  information
model branch {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  location          String
  isOpen            Boolean             @default(true)
  latitude          Float
  longitude         Float
  openingTime       String
  closingTime       String
  verticalBanner    verticalBanner[]
  horizontalBanner  horizontalBanner[]
  handalingCharge   handalingCharge[]
  cartValue         cartValue[]
  User              User[]
  order             order[]
  product           product[]
  productCategory   productCategory[]
  livePhotoCategory livePhotoCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branchs")
}

model livePhoto {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  livePhotoCategory   livePhotoCategory? @relation(fields: [livePhotoCategoryId], references: [id], onDelete: Cascade)
  livePhotoCategoryId String?            @db.ObjectId
  photo               String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model livePhotoCategory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String      @unique
  image     String
  branchId  String      @db.ObjectId
  branch    branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  livePhoto livePhoto[]
}

model handalingCharge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  charge    Float
  condition String
  branch    branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("handalingCharges")
}

model cartValue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  minValue  Float
  branch    branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cartValues")
}

// ---------------------------------  Banner Models -------------------------///

model verticalBanner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId String? @db.ObjectId

  @@map("verticalBanners")
}

model horizontalBanner {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  branch                 branch?                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId               String?                  @db.ObjectId
  horizontalBannerSlider horizontalBannerSlider[]

  @@unique([branchId])
  @@map("horizontalBanners")
}

model horizontalBannerSlider {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  serialNo  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horizontalBanner   horizontalBanner? @relation(fields: [horizontalBannerId], references: [id], onDelete: Cascade)
  horizontalBannerId String?           @db.ObjectId

  @@unique([horizontalBannerId])
  @@map("horizontalBannerSliders")
}

//-//-------------------------------------- Product and Order Models --------------------//

model product {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  images     String[]
  tag        String
  status     Boolean         @default(true)
  branchId   String          @db.ObjectId
  branch     branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  categoryId String          @db.ObjectId
  category   productCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orderProduct     orderProduct[]
  productVariation productVariation[]

  @@map("products")
}

model productVariation {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  realPrice         Float
  sellingPrice      Float
  availableQuantity Int
  minOrderQuantity  Int
  maxOrderQuantity  Int
  unit              unit
  weight            Float

  product   product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?  @db.ObjectId
}

enum unit {
  KG
  Box
  Punnet
  Tray
}

model productCategory {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String               @unique
  image              String?
  branchId           String               @db.ObjectId
  branch             branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  productSubcategory productSubcategory[]
  product            product[]

  @@map("productCategories")
}

model productSubcategory {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  productCategoryId String?          @db.ObjectId
  productCategory   productCategory? @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("productSubcategories")
}

// ---------------------------------  Order Models -------------------------///`
model order {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String           @unique
  user              User?            @relation(fields: [userId], references: [id])
  userId            String?          @db.ObjectId
  products          orderProduct[]
  totalAmount       Float
  isPaid            Boolean?         @default(false)
  status            OrderStatus      @default(Pending)
  shippingAddressId String?          @db.ObjectId
  shippingAddress   shippingAddress? @relation(fields: [shippingAddressId], references: [id])
  branchId          String?          @db.ObjectId
  branch            branch?          @relation(fields: [branchId], references: [id])

  // Payment tracking
  paymentMethod PaymentMethod? @default(COD)

  // Wallet payment tracking
  walletAmountUsed Float? @default(0)

  // Dues/Credit tracking
  isDues        Boolean?  @default(false)
  duesCleared   Boolean?  @default(false)
  duesClearedAt DateTime?

  // Return tracking
  isReturned          Boolean? @default(false)
  isPartialReturn     Boolean? @default(false)
  totalReturnedAmount Float?   @default(0)

  // MainOrder relation
  mainOrderId String?    @db.ObjectId
  mainOrder   MainOrder? @relation(fields: [mainOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model orderProduct {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  order            order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String?  @db.ObjectId
  product          product? @relation(fields: [productId], references: [id])
  productId        String?  @db.ObjectId
  variationId      String?  @db.ObjectId
  quantity         Int
  price            Float
  returnedQuantity Int      @default(0)
  isReturned       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("orderProducts")
}

enum PaymentMethod {
  COD // cash on delivery
  Wallet // wallet amount used
  Credit // delivery boy assign as credit and user clear dues later
  QrCode // delivery boy show scanner and collects payment
  Online // after clearing dues
}

enum PaymentStatus {
  Pending
  Success
  Failed
  Refunded
  PartiallyRefunded
}

/// ------ Main Order Model (Daily Aggregation) -----///

model MainOrder {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  userId              String          @db.ObjectId
  orders              order[]
  totalAmount         Float
  pendingAmount       Float           @default(0) // COD + unpaid amounts
  totalReturnedAmount Float           @default(0)
  totalWalletUsed     Float           @default(0)
  totalDuesAmount     Float           @default(0)
  isDuesCleared       Boolean         @default(false)
  status              MainOrderStatus @default(Pending) // Overall status of the main order
  isClosed            Boolean         @default(false) // True after midnight cutoff
  orderDate           DateTime // Date when orders were placed
  closedAt            DateTime? // When the order was closed (midnight)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, orderDate])
  @@index([isClosed, orderDate])
  @@map("mainOrders")
}

enum OrderStatus {
  Pending
  Processing
  onTheway
  Delivered
  Cancelled
  deliveredWithPartiallyReturned
  FullyReturned
}

enum MainOrderStatus {
  Pending
  Processing
  onTheway
  Delivered
  Cancelled
  deliveredWithPartiallyReturned
  FullyReturned
}

/// ------ Buyer  Review Model -----///

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

/// ---------- Wallet and spins Models -----//

model Wallet {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  user               User?               @relation(fields: [userId], references: [id])
  userId             String?             @unique @db.ObjectId
  balance            Float               @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
  WalletRecharge     WalletRecharge[]

  @@index([userId, id])
  @@map("wallets")
}

model WalletTransaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  wallet      Wallet?         @relation(fields: [walletId], references: [id])
  walletId    String?         @db.ObjectId
  amount      Float
  type        TransactionType
  description String? // e.g., "Order payment", "Refund for order #123"
  orderId     String? // Track which order this transaction is for
  status      String?         @default("Success") // "Success", "Pending", "Failed"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("walletTransactions")
}

enum TransactionType {
  Credit
  Debit
}

model WalletRecharge {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  wallet           Wallet?       @relation(fields: [walletId], references: [id])
  walletId         String?       @db.ObjectId
  amount           Float
  paymentGateway   String        @default("cashfree")
  cashfreeOrderId  String?       @unique
  paymentSessionId String?
  paymentStatus    PaymentStatus @default(Pending)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("walletRecharges")
}

/// ------ Dues Payment Model (for clearing dues) -----///
model DuesPayment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  user             User?         @relation(fields: [userId], references: [id])
  userId           String?       @db.ObjectId
  orderIds         String[] // Array of order IDs being cleared
  amount           Float // Total amount being paid
  paymentGateway   String        @default("cashfree")
  cashfreeOrderId  String?       @unique
  paymentSessionId String?
  paymentStatus    PaymentStatus @default(Pending)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("duesPayments")
}

// -------------------------------- Spin Models -------------------------///

model Spin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  wonAmount Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spins")
}

model spinValue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId  String   @db.ObjectId
  spinValue Float
  month     DateTime
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, month, year], name: "branch_month_year_index")
  @@map("spinValues")
}

/// --- ------------------------------- Contact and Notification Models --------//
model contact {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------  Notification Models -------------------------///
model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String?  @db.ObjectId
  senderId   String?  @db.ObjectId
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

//-------------------------------------- assign delivery driver to order---------------------///

model DriverAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId   String   @db.ObjectId
  orderId    String   @db.ObjectId
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("driverAssignments")
}
