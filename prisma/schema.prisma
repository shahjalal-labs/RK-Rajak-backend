datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String?
  phone             String             @unique
  address           String?
  email             String?
  isProfileComplete Boolean            @default(false)
  isVerifyed        Boolean            @default(false)
  buyerRating       Float?
  fcmToken          String?
  profileImage      String?            @default("https://i.ibb.co.com/nrs3FjM/images.png")
  shopOpeningTime   String?
  role              UserRole
  status            UserStatus         @default(Active)
  referralCode      String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  branch            branch?            @relation(fields: [branchId], references: [id])
  branchId          String?            @db.ObjectId
  order             order[]
  shippingAddress   shippingAddress[]
  verificationUsers verificationUsers?
  UserLocation      UserLocation?
  Wallet            Wallet?
  Spin              Spin[]
  Review            Review[]

  @@map("users")
}

model PendingUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  role      UserRole @default(Customer)
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pendingUsers")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  phone     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  All
  New
  Active
  Inactive
  Reactivate
  Online
  Offline
  PerDayOrder
  Blocked
  Deleted
}

enum UserRole {
  SuperAdmin
  Admin
  Customer
  Agent
  Owner
  Driver
}

model UserLocation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id] )

  @@map("user_locations")
}

model shippingAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id] )
  userId    String?  @db.ObjectId
  shopName  String
  landmark  String
  address   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     order[]

  @@map("shippingAddresses")
}

model verificationUsers {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User?    @relation(fields: [userId], references: [id] )
  userId     String?  @unique @db.ObjectId
  buyerName  String
  buyerPhoto String
  shopName   String
  shopPhoto  String
  documents  String[]
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("verificationUsers")
}

// ------- branchs  information
model branch {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  location          String
  latitude          Float
  longitude         Float
  openingTime       String
  closingTime       String
  verticalBanner    verticalBanner[]
  horizontalBanner  horizontalBanner[]
  handlaningCharge  handlaningCharge[]
  cartValue         cartValue[]
  User              User[]
  order             order[]
  product           product[]
  productCategory   productCategory[]
  livePhotoCategory livePhotoCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branchs")
}

model livePhoto {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  livePhotoCategory   livePhotoCategory? @relation(fields: [livePhotoCategoryId], references: [id] , onDelete: Cascade)
  livePhotoCategoryId String?            @db.ObjectId
  photo               String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model livePhotoCategory {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String      @unique
  image     String
  branchId  String      @db.ObjectId
  branch    branch      @relation(fields: [branchId], references: [id] ,  onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  livePhoto livePhoto[]
}

model handlaningCharge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  charge    Float
  condition String
  branch    branch?  @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("handlaningCharges")
}

model cartValue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  minValue  Float
  branch    branch?  @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  branchId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cartValues")
}

model verticalBanner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   branch? @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  branchId String? @db.ObjectId

  @@map("verticalBanners")
}

model horizontalBanner {
  id                     String                   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  branch                 branch?                  @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  branchId               String?                  @db.ObjectId
  horizontalBannerSlider horizontalBannerSlider[]

  @@unique([branchId])
  @@map("horizontalBanners")
}

model horizontalBannerSlider {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  image     String
  serialNo  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horizontalBanner   horizontalBanner? @relation(fields: [horizontalBannerId], references: [id] , onDelete: Cascade)
  horizontalBannerId String?           @db.ObjectId

  @@unique([horizontalBannerId])
  @@map("horizontalBannerSliders")
}

//-//--------------- Product and Order Models -----//

model product {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  images     String[]
  tag        String
  status     Boolean         @default(true)
  branchId   String          @db.ObjectId
  branch     branch          @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  categoryId String          @db.ObjectId
  category   productCategory @relation(fields: [categoryId], references: [id] , onDelete: Cascade)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orderProduct     orderProduct[]
  productVariation productVariation[]

  @@map("products")
}

model productVariation {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  realPrice         Float
  sellingPrice      Float
  availableQuantity Int
  minOrderQuantity  Int
  maxOrderQuantity  Int
  unit              unit
  weight            Float

  product   product? @relation(fields: [productId], references: [id] , onDelete: Cascade)
  productId String?  @db.ObjectId
}

enum unit {
  KG
  Box
  Punnet
  Tray
}

model productCategory {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  name               String               @unique
  branchId           String               @db.ObjectId
  branch             branch               @relation(fields: [branchId], references: [id] , onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  productSubcategory productSubcategory[]
  product            product[]

  @@map("productCategories")
}

model productSubcategory {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  productCategoryId String?          @db.ObjectId
  productCategory   productCategory? @relation(fields: [productCategoryId], references: [id] , onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("productSubcategories")
}

model order {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String           @unique
  user              User?            @relation(fields: [userId], references: [id])
  userId            String?          @db.ObjectId
  products          orderProduct[]
  totalAmount       Float
  isPaid            Boolean?
  status            OrderStatus      @default(Pending)
  shippingAddressId String?          @db.ObjectId
  shippingAddress   shippingAddress? @relation(fields: [shippingAddressId], references: [id])
  branchId          String?          @db.ObjectId
  branch            branch?          @relation(fields: [branchId], references: [id])
  paymentMethodId   String?
  paymentIntentId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("orders")
}

model orderProduct {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  order     order?   @relation(fields: [orderId], references: [id] , onDelete: Cascade)
  orderId   String?  @db.ObjectId
  product   product? @relation(fields: [productId], references: [id])
  productId String?  @db.ObjectId
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orderProducts")
}

enum OrderStatus {
  Pending
  onTheway
  Delivered
  Cancelled
}

/// ------ Buyer  Review Model -----///

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

/// ---------- Wallet and spins Models -----//

model Wallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @unique @db.ObjectId
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Spin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
  wonAmount Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spins")
}

/// --- --------------- Contact and Notification Models -----//
model contact {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String?  @db.ObjectId
  senderId   String?  @db.ObjectId
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}
